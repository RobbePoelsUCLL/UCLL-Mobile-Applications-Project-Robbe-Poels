{
  "expo": {
    "name": "UCLL Mobile Starter",
    "slug": "ucll-mobile-starter",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "ucllstarter",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow $(PRODUCT_NAME) to use your location to find nearby places to explore."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "baseUrl": "/UCLL-Mobile-Applications-Project-Robbe-Poels"
    }
  }
}
